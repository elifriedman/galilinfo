# Copy to the handler deployment environment and replace every placeholder.
# These sample values are not credentials and are not valid deployment settings.

# WhatsApp handler. Disabled unless explicitly enabled.
OPENHOURS_CONVERSATION_ENABLED=false
OPENHOURS_GROUP_ID=REPLACE_WITH_WHATSAPP_GROUP_ID
OPENHOURS_AUTHORIZED_PHONE_NUMBER=REPLACE_WITH_E164_OPERATOR_PHONE
OPENHOURS_PLACES_PATH=/path/to/galilinfo/data/places.json
OPENHOURS_PENDING_DB=/path/to/durable/openhours.pending.sqlite3

# WhatsApp GoWa connection.
WHATSAPP=REPLACE_WITH_USERNAME:REPLACE_WITH_PASSWORD
WHATSAPP_BASE_URL=http://localhost:3001

# OpenAI-compatible model provider.
CLASSIFIER_BASE_URL=https://api.tokenfactory.nebius.com/v1/
CLASSIFIER_API_KEY=REPLACE_WITH_MODEL_PROVIDER_API_KEY
CLASSIFIER_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Google Places (New), used for hours previews.
GOOGLE_MAPS_PLACES_API_KEY=REPLACE_WITH_GOOGLE_MAPS_PLACES_API_KEY

# Runtime limits. The handler fails closed if any cap is absent, invalid, or <= 0.
OPENHOURS_MAX_TURNS=4
OPENHOURS_MAX_REVISIONS=3
OPENHOURS_MAX_TOOL_CALLS=8
OPENHOURS_MAX_CONCURRENT_MODEL_REQUESTS=1
